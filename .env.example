# --- Telegram ---
BOT_TOKEN=
# Chat nhận nhắc việc. Lần đầu chưa biết thì để trống, gửi 1 tin cho bot rồi lấy chat_id.
TELEGRAM_CHAT_ID=
# Domain public HTTPS (Railway cấp sau khi deploy). Để trống khi dev local -> bỏ qua setWebhook.
TELEGRAM_WEBHOOK_URL=
# Chuỗi bí mật tự đặt, Telegram gửi lại trong header X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=

# --- Database (Neon) ---
DATABASE_URL=

# --- LLM (chỉ key; model/temperature/timeout/prompt xem models.yaml) ---
GOOGLE_API_KEY=your-google-api-key

# --- Nhịp nhắc Job A (phút), dùng chung cho mọi việc chưa xong ---
PENDING_INTERVAL_MIN=30
ESCALATION_OVERDUE_DAYS=1
# Hoàn tác "đã xong" / "đã hủy" trong ngần này giờ (R8)
UNDO_WINDOW_HOURS=24
# Còn ngần này ngày (hoặc ít hơn) tới hạn mà chưa xong thì cũng nâng lên ưu tiên
ESCALATION_DUE_SOON_DAYS=3

# --- Khung giờ được phép nhắc ---
REMINDER_WINDOW_START_HOUR=8
REMINDER_WINDOW_END_HOUR=18
LOCAL_TIMEZONE=Asia/Ho_Chi_Minh

# --- Langfuse (tuỳ chọn): sửa prompt trên UI + trace agent ---
# Để trống thì dùng prompt trong reminder_agent/prompts/*.md, không trace.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Vận hành ---
JOB_A_INTERVAL_MINUTES=1
# Dọn checkpoint LangGraph cũ hơn ngần này ngày (chạy 3h sáng)
CHECKPOINT_RETENTION_DAYS=14
