# --- Telegram: HAI bot riêng ---
# TAR_admin_bot — nạp và quản lý tài liệu
ADMIN_BOT_TOKEN=123456:ABC-token-cua-bot-admin
# TAR_Client_bot — hỏi đáp
CLIENT_BOT_TOKEN=654321:XYZ-token-cua-bot-client

# Telegram user id được phép dùng bot admin, phân tách bằng dấu phẩy.
# ĐỂ TRỐNG = KHÔNG AI dùng được bot admin. Chưa biết id thì nhắn cho bot một tin
# rồi xem log, hoặc hỏi @userinfobot.
ADMIN_TELEGRAM_IDS=

# Domain public HTTPS (Railway cấp sau khi deploy). Để trống khi dev local ->
# bỏ qua setWebhook, cả hai bot tự chuyển sang polling.
# Hai đường dẫn: <domain>/webhooks/telegram/admin và /webhooks/telegram/client
TELEGRAM_WEBHOOK_URL=
# Mỗi bot một secret riêng: lộ cái này không kéo theo cái kia.
ADMIN_WEBHOOK_SECRET=doi-chuoi-nay-thanh-cua-ban
CLIENT_WEBHOOK_SECRET=doi-chuoi-nay-thanh-cua-ban-nua

# --- Database (Neon, cần extension pgvector) ---
DATABASE_URL=postgresql+psycopg://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# --- LLM (chỉ key; model/temperature/timeout xem TAR_agent/utils/models.yaml,
#     prompt là các file .md trong TAR_agent/utils/prompts/) ---
GOOGLE_API_KEY=your-google-api-key

# --- Vận hành ---
LOCAL_TIMEZONE=Asia/Ho_Chi_Minh
# Trần kích thước file nạp lên (MB). Bot API của Telegram tự chặn ở 20MB.
MAX_UPLOAD_MB=20
# Dọn checkpoint LangGraph cũ hơn ngần này ngày. Job này ĐANG TẮT trong
# app/main.py — xem comment ở lifespan() để bật lại.
CHECKPOINT_RETENTION_DAYS=14
